VITE_GOOGLE_MAPS_API_KEY=
# OAuth 2.0 Client ID (Web application) from Google Cloud Console, with the
# Gmail API enabled and this app's origin(s) added under "Authorized
# JavaScript origins". Used client-side only (no client secret needed) to
# request read-only Gmail access for the "Establecer comunicación" feature.
VITE_GOOGLE_CLIENT_ID=
# Application (client) ID from an Azure AD / Microsoft Entra app
# registration (type: Single-page application), with the Mail.Read
# delegated permission granted and this app's origin(s) added as a
# SPA redirect URI. Used client-side only (no client secret) for the
# "Establecer comunicación" Outlook option.
VITE_MICROSOFT_CLIENT_ID=
